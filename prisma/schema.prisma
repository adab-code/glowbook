// GlowBook — data model (see docs/data-model.md for the field-level rationale)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A beauty studio. The tenancy root: every other record belongs to exactly one.
model Account {
  id                 String   @id @default(uuid()) @db.Uuid
  studioName         String   @db.VarChar(120)
  slug               String   @unique @db.VarChar(140)
  timezone           String   @default("America/Boise") @db.VarChar(64)
  currency           String   @default("USD") @db.VarChar(3)
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staffUsers   StaffUser[]
  invitations  StaffInvite[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]

  @@index([slug])
}

/// A person who can sign in. The first signup for an Account is always the OWNER.
model StaffUser {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @db.VarChar(255)
  role            StaffRole @default(STAFF)
  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  phone           String?   @db.VarChar(32)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  acceptedInvitations StaffInvite[]        @relation("AcceptedInvite")
  resetTokens         PasswordResetToken[]

  @@index([accountId])
}

/// A pending invitation for a staff member (FR-007). Token is hashed at rest.
model StaffInvite {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @db.Uuid
  email      String    @db.VarChar(255)
  role       StaffRole @default(STAFF)
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  acceptedBy   StaffUser? @relation("AcceptedInvite", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById String?    @db.Uuid

  @@index([accountId, acceptedAt])
  @@index([email])
}

/// A person the studio serves. Soft-deleted with isArchived so history survives.
model Client {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @db.Uuid
  firstName  String   @db.VarChar(80)
  lastName   String   @db.VarChar(80)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(32)
  notes      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([accountId, lastName])
}

/// An offering the studio provides. priceCents is always an integer.
model Service {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  priceCents      Int
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments AppointmentService[]

  @@index([accountId, isActive])
}

/// A scheduled booking. endsAt derives from service durations; priceCentsTotal is
/// a snapshot so later price edits never rewrite history.
model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  accountId          String            @db.Uuid
  clientId           String            @db.Uuid
  staffUserId        String?           @db.Uuid
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?
  priceCentsTotal    Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  account   Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staffUser StaffUser?           @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  services  AppointmentService[]

  @@index([accountId, startsAt])
  @@index([staffUserId, startsAt, endsAt])
  @@index([clientId, startsAt])
}

/// Join table resolving the Appointment <-> Service many-to-many.
model AppointmentService {
  appointmentId String @db.Uuid
  serviceId     String @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@index([serviceId])
}

/// Single-use, time-limited password reset link (FR-005). Only the hash is stored.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
}
