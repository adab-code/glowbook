# Copy to .env.local (development) and fill in real values.
# Never commit .env.local — `.gitignore` already ignores every .env* file
# except this example.

# --- Database ---------------------------------------------------------------
# Local development (PostgreSQL 18 installed locally):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/glowbook?schema=public"

# Render deployment: create a Free Postgres instance, allow the web service in
# its Access settings, then paste the instance's Internal Database URL below.
# Render does not expose a separate connection pooler on the free tier, so
# DATABASE_URL and DIRECT_URL are the same string here.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/glowbook"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/glowbook"

# --- Auth.js ----------------------------------------------------------------
# Generate with `npx auth secret`.
AUTH_SECRET=""

# Set to true when deploying behind Render (or any other proxy) so Auth.js
# trusts the incoming host header.
AUTH_TRUST_HOST="true"

# --- Metadata / SEO ---------------------------------------------------------
# Absolute public URL of the deployed app. Used for metadataBase and social
# (Open Graph) links. Optional locally — defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://YOUR-RENDER-APP.onrender.com"

# --- Seed only --------------------------------------------------------------
# Password given to the demo owner@glowbook.dev / staff@glowbook.dev accounts.
SEED_PASSWORD="GlowBook!2026"
