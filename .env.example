# Copy to .env.local (development) and fill in real values.
# Never commit .env.local — `.gitignore` already ignores every .env* file
# except this example.

# --- Database ---------------------------------------------------------------
# Local development (PostgreSQL 18 installed locally):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/glowbook?schema=public"

# Vercel deployment: use a managed PostgreSQL provider (Supabase, Neon, Vercel
# Postgres) and paste the pooled connection string here, plus the direct
# (non-pooled) one for migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/glowbook?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/glowbook"

# --- Auth.js ----------------------------------------------------------------
# Generate with `npx auth secret`.
AUTH_SECRET=""

# Set to true when deploying behind Vercel or any other proxy so Auth.js
# trusts the incoming host header.
AUTH_TRUST_HOST="true"

# --- Seed only --------------------------------------------------------------
# Password given to the demo owner@glowbook.dev / staff@glowbook.dev accounts.
SEED_PASSWORD="GlowBook!2026"
