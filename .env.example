# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase PostgreSQL — pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL — direct connection string used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.co:5432/postgres"

# Auth.js — generate with `npx auth secret`.
AUTH_SECRET=""

# Auth.js — set to true when deploying behind Vercel/proxy so it trusts the host.
AUTH_TRUST_HOST="true"

# PostHog / analytics and other integrations are added as the project grows.
